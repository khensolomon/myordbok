{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "MyOrdbok",
	"version": "0.0.0",
	"identifier": "com.myordbok.app",
	"build": {
		"frontendDist": "../dist/tauri"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"title": "MyOrdbok",
				"width": 1100,
				"height": 800,
				"minWidth": 360,
				"minHeight": 480
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
		"android": {
			"minSdkVersion": 24
		},
		"iOS": {
			"developmentTeam": "AY23P8UZ8P"
		}
	}
}
