{
	"$schema": "../gen/schemas/mobile-schema.json",
	"identifier": "default",
	"description": "What the app's pages may ask of the native side: the MyOrdbok API, opening links in the system browser, light haptic taps, and the store's payments for supporting MyOrdbok.",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"opener:default",
		"haptics:allow-selection-feedback",
		"haptics:allow-impact-feedback",
		"iap:allow-get-products",
		"iap:allow-purchase",
		"iap:allow-restore-purchases",
		"iap:allow-acknowledge-purchase",
		"iap:allow-consume-purchase",
		{
			"identifier": "http:default",
			"allow": [{ "url": "https://myordbok.com/api/*" }, { "url": "https://beta.myordbok.com/api/*" }]
		}
	]
}
