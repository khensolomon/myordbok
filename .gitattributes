# Normalise line endings to LF
* text=auto eol=lf

*.png binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.psd binary

# Left out of release archives
/assets export-ignore
/docs export-ignore
/tests export-ignore
.editorconfig export-ignore
.gitattributes export-ignore
.gitignore export-ignore
