{
	"name": "myordbok",
	"version": "26.11.7+1",
	"description": "a comprehensive online Myanmar dictionary",
	"keywords": [
		"myordbok",
		"dictionary",
		"myanmar",
		"pwa"
	],
	"private": true,
	"type": "module",
	"imports": {
		"#shared/*": "./shared/*",
		"#platform/*": "./app/platform/web/*"
	},
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "node scripts/serve.js",
		"dev:api": "wrangler dev --local --port 8787",
		"db:migrate": "wrangler d1 migrations apply myordbok --local",
		"db:seed": "wrangler d1 execute myordbok --local --file db/seed.dev.sql",
		"build": "node scripts/build.js",
		"build:tauri": "node scripts/build.js --target tauri",
		"test": "node --test \"tests/*.test.js\"",
		"version:next": "node scripts/version.js",
		"deploy": "node scripts/build.js && wrangler deploy"
	},
	"devDependencies": {
		"wrangler": "^4.158.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/khensolomon/myordbok.git"
	},
	"author": "Khen Solomon Lethil",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/khensolomon/myordbok/issues"
	},
	"homepage": "https://github.com/khensolomon/myordbok#readme"
}
