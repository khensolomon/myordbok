{
	"name": "myordbok",
	"version": "26.11.8+27",
	"description": "a comprehensive online Myanmar dictionary",
	"keywords": [
		"myordbok",
		"dictionary",
		"myanmar",
		"pwa"
	],
	"private": true,
	"type": "module",
	"imports": {
		"#shared/*": "./shared/*",
		"#platform/*": "./app/platform/web/*"
	},
	"engines": {
		"node": ">=22.13"
	},
	"scripts": {
		"dev": "node scripts/serve.js",
		"dev:api": "node scripts/build.js && wrangler dev --local --port 8787",
		"db:migrate": "wrangler d1 migrations apply myordbok-app --local",
		"data:sample": "wrangler d1 execute DICTIONARY --local --yes --file assets/db/seed.dev.sql",
		"build": "node scripts/build.js",
		"build:beta": "node scripts/build.js --noindex",
		"build:tauri": "node scripts/build.js --target tauri",
		"test": "node --disable-warning=ExperimentalWarning --test \"tests/*.test.js\"",
		"version:next": "node scripts/version.js"
	},
	"devDependencies": {
		"wrangler": "^4.158.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/khensolomon/myordbok.git"
	},
	"author": "Khen Solomon Lethil",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/khensolomon/myordbok/issues"
	},
	"homepage": "https://github.com/khensolomon/myordbok#readme"
}
